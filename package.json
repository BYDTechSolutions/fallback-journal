{
  "name": "@bydtech/fallback-journal",
  "version": "0.1.1",
  "description": "When a database write fails, keep the record on disk as one JSON line and save it later, so a restart never loses a signup, a lead or an order.",
  "keywords": [
    "journal",
    "write-ahead",
    "fallback",
    "outbox",
    "retry",
    "replay",
    "ndjson",
    "database",
    "durability",
    "resilience"
  ],
  "homepage": "https://github.com/BYDTechSolutions/fallback-journal#readme",
  "bugs": {
    "url": "https://github.com/BYDTechSolutions/fallback-journal/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BYDTechSolutions/fallback-journal.git"
  },
  "license": "MIT",
  "author": "BYD Tech <sales.bydtech@gmail.com> (https://bydtech.in)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "fallback-journal": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
